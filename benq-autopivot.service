[Unit]
Description=Rotate the desktop to follow the BenQ monitor's physical pivot
Documentation=file:%h/.local/lib/benq-autopivot/autopivot.py
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/lib/benq-autopivot/autopivot.py --connector DP-3
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
